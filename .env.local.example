# Copy this file to .env.local for browser development.
# Find these values in Supabase Project Settings, API Keys.
# The application keeps the ANON_KEY variable name for compatibility, but it can
# contain the current sb_publishable key or a legacy anon key.
# These values are included in the static browser build. Row Level Security and
# authenticated database functions enforce access.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_REPLACE_ME

# Do not add server secrets to this file or to any NEXT_PUBLIC variable.
# Stripe, Resend, and optional Twilio values belong in Edge Function secrets.
# See docs/inquiry-messaging-rollout.md before enabling SMS.
# See SUPABASE_SETUP.md and supabase/functions/README.md.
