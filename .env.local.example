# Copy this file to .env.local and fill in your Supabase project values.
# Find these in your Supabase dashboard: Project Settings → API.
# The anon key is safe to expose publicly — access is controlled by Row Level Security.
# These are read at BUILD time (static export), so rebuild after changing them.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
